generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // switch to "postgresql" when DATABASE_URL is postgres
  url      = env("postgresql://dkilic:FlBVoT1YSxLpirMWqrHfg24ZPZSxdfa5@dpg-d6cf108eumvs73badds0-a.frankfurt-postgres.render.com/darthistory")
}

model Match {
  id                 String   @id
  createdAt          DateTime @default(now())
  startScore         Int
  playersCount       Int
  doubleOut          Boolean  @default(false)
  currentPlayerIndex Int      @default(0)

  players Player[]
  turns   Turn[]

  @@index([createdAt])
}

model Player {
  id      String @id
  matchId String
  name    String
  score   Int
  order   Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  turns Turn[]

  @@unique([matchId, order])
  @@index([matchId])
}

model Turn {
  id          String   @id
  createdAt   DateTime @default(now())
  matchId     String
  playerId    String
  darts       Json
  total       Int
  scoreBefore Int
  scoreAfter  Int
  busted      Boolean
  bustReason  String?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([playerId, createdAt])
}
